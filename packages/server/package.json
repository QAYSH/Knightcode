{
   "name": "@nightcode/server",
   "type": "module",
   "private": "true",
   "export": {
      ".": "./src/index.ts"
   },
   "scripts": {
      "dev": "bun run --hot src/index.ts",
      "build": "bun build src/index.ts --outdir dist --target bun",
      "postinstall": "bun run --cwd ../database db:generate"
   },
   "dependencies": {
      "@ai-sdk/anthropic": "^4.0.29",
      "@ai-sdk/google": "^4.0.34",
      "@ai-sdk/openai": "^4.0.29",
      "@ai-sdk/provider-utils": "^5.0.21",
      "@clerk/backend": "^3.16.1",
      "@hono/zod-validator": "^0.9.0",
      "@nightcode/database": "workspace:*",
      "@nightcode/shared": "workspace:*",
      "@sentry/bun": "^10.69.0",
      "@sentry/hono": "^10.69.0",
      "ai": "^7.0.51",
      "dotenv": "^17.4.2",
      "hono": "^4.12.31",
      "zod": "^4.4.3"
   }
}