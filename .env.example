STANDALONE=true
#OPTION 1: STANDALONE MODE (Recommended for personal & offline use)
# No PostgreSQL, no Clerk, no Polar, and no backend server needed!
# Sessions are stored locally in SQLite (~/.nightcode/nightcode.db).

# Provide at least one API key (or point to local Ollama / LM Studio):
OPENAI_API_KEY=your_openai_or_compatible_api_key
# OPENAI_BASE_URL=http://localhost:11434/v1          # For Ollama
# OPENAI_BASE_URL=https://api.deepseek.com/v1       # For DeepSeek
# OPENAI_BASE_URL=https://openrouter.ai/api/v1      # For OpenRouter

# Or use Anthropic:
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional model configuration:
# DEFAULT_MODEL=gpt-4o
# CUSTOM_MODELS=qwen2.5-coder:32b,deepseek-chat,claude-3-7-sonnet-latest

#OPTION 2: FULL SERVER / MULTI-TENANT MODE (Backend + Postgres + Clerk + Polar)
# Only required if you are hosting the multi-user backend infrastructure.
# API_URL=http://localhost:3000
# DATABASE_URL=postgresql://user:password@localhost:5432/nightcode?schema=public

# Clerk OAuth
# CLERK_FRONTEND_API=your_clerk_frontend_api_url
# CLERK_OAUTH_CLIENT_SECRET=your_oauth_client_secret
# CLERK_OAUTH_CLIENT_ID=your_oauth_client_id
# CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# CLERK_SECRET_KEY=your_clerk_secret_key
# JWT_SECRET=jwt-secret

# Polar Credits & Metering
# POLAR_ACCESS_TOKEN=your_polar_access_token
# POLAR_PRODUCT_ID=your_polar_product_id
# POLAR_SERVER=sandbox  # or production
# POLAR_CREDITS_METER_ID=your_polar_credits_meter_id
